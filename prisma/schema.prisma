// Recruited — the hiring side of Hired.
//
// Every content model carries userId, and every function in src/lib/data takes it
// as its first positional argument. One account is one hiring workspace; nothing
// lets one account read another's jobs, candidates or answers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  MEMBER
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String   @default("")
  /// The company the person hires for. Shown on every public apply page.
  companyName     String   @default("")
  /// A few sentences about the company, shown on every public job page.
  companyAbout    String   @default("")
  companyWebsite  String   @default("")
  /// The public careers page's address, /careers/<careersSlug>. Null until set.
  careersSlug     String?  @unique
  /// Months an applicant's data is kept after their role closes, then deleted.
  /// Hires are kept. 0 keeps everything until someone deletes it.
  retentionMonths Int      @default(12)
  /// Where applicants write to see or delete their data. Shown on every apply form.
  privacyEmail    String   @default("")
  passwordHash    String
  role            UserRole @default(MEMBER)
  createdAt       DateTime @default(now())

  sessions     Session[]
  resets       PasswordReset[]
  connections  Connection[]
  jobs         Job[]
  listings     Listing[]
  forms        Form[]
  candidates   Candidate[]
  applications Application[]
  submissions  Submission[]
  answers      Answer[]
  notes        Note[]
  uploads      Upload[]
  messages     Message[]
  interviews   Interview[]
  scorecards   Scorecard[]
  offers       Offer[]
  references   Reference[]
  mailbox      Mailbox?
}

model Session {
  token     String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A one-time link to set a new password, valid for an hour. Only a SHA-256
/// of the token is stored, so a database read can't be turned into a sign-in.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One MCP connection URL. The token in the path resolves to exactly one user.
model Connection {
  id         String    @id @default(cuid())
  userId     String
  name       String    @default("Claude")
  token      String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
}

/// A role you are hiring for. The description is the source every listing is written from.
model Job {
  id             String    @id @default(cuid())
  userId         String
  title          String
  team           String    @default("")
  location       String    @default("")
  /// remote | hybrid | onsite
  workplace      String    @default("remote")
  /// full_time | part_time | contract | internship | temporary
  employmentType String    @default("full_time")
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String    @default("USD")
  /// hour | month | year
  salaryPeriod   String    @default("year")
  /// Markdown. The canonical description; listings are adapted from it.
  description    String    @default("")
  /// What makes an A, B or C applicant for this role, in the hiring person's words. Read by rank_applicants.
  rubric         String    @default("")
  status         JobStatus @default(DRAFT)
  /// When the job last became CLOSED. The retention clock starts here.
  closedAt       DateTime?
  /// What applicants are told happens after they apply, shown on the thank-you page. Empty uses the default.
  afterApply     String    @default("")
  /// Part of the demo workspace (load_sample_workspace). wipe_sample_workspace deletes only these.
  sample         Boolean   @default(false)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings     Listing[]
  forms        Form[]
  applications Application[]

  @@index([userId, status])
}

enum ListingStatus {
  DRAFT
  LIVE
  PAUSED
  CLOSED
}

/// One version of a job on one board. Two listings for the same job on the same board
/// are a split test; each has its own apply link, which is how an application knows
/// which listing brought it.
model Listing {
  id          String        @id @default(cuid())
  userId      String
  jobId       String
  /// A key from src/lib/boards.ts: linkedin, indeed, onlinejobs_ph, wellfound, upwork, careers, generic.
  board       String
  /// "A", "B", … — unique per job and board.
  variant     String        @default("A")
  title       String
  /// Markdown as written. The board's own format is rendered from it on read.
  body        String        @default("")
  slug        String        @unique
  status      ListingStatus @default(DRAFT)
  /// Where the listing lives on the board once it is posted.
  externalUrl String        @default("")
  /// What this listing has cost so far, in cents of the job's currency.
  spendCents  Int           @default(0)
  postedAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  job          Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applications Application[]

  @@unique([jobId, board, variant])
  @@index([userId])
}

enum FormKind {
  APPLICATION
  SCREENING
}

/// A set of questions. A job has at most one APPLICATION form (what the apply page asks)
/// and any number of SCREENING forms (sent to an applicant after they apply).
model Form {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  kind      FormKind
  name      String   @default("")
  /// FormQuestion[] — see src/lib/forms.ts. Replaced whole on update.
  questions Json     @default("[]")
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([userId, jobId])
}

model Candidate {
  id        String   @id @default(cuid())
  userId    String
  name      String
  email     String
  phone     String   @default("")
  /// Free-form links: LinkedIn, portfolio, a published Hired resume.
  links     String[] @default([])
  sample    Boolean  @default(false)
  createdAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]
  submissions  Submission[]

  @@unique([userId, email])
}

/// How strong an applicant is for this job. Data, never decoration: see brand/BRAND.md.
enum Tier {
  A
  B
  C
}

enum Stage {
  NEW
  SCREEN
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

model Application {
  id             String    @id @default(cuid())
  userId         String
  jobId          String
  candidateId    String
  /// The listing whose apply link they used. Null when added by hand or imported.
  listingId      String?
  /// Where it came from when there is no listing: "referral", "sourced", a board name.
  source         String    @default("")
  stage          Stage     @default(NEW)
  /// Whether every knockout question so far was answered acceptably. Null when no form had one.
  qualified      Boolean?
  /// The tier a person decided (in the app, or by telling their assistant). Null until then.
  tier           Tier?
  tierReason     String    @default("")
  /// "app" or "mcp": where the decision was made.
  tierBy         String    @default("")
  tierAt         DateTime?
  /// What an assistant proposed with rank_applicants. Never overwrites tier.
  proposedTier   Tier?
  proposedReason String    @default("")
  /// 1 is the strongest in the job, from the last ranking.
  proposedRank   Int?
  proposedAt     DateTime?
  /// A private token for the screening link sent to this applicant.
  screenToken    String    @unique
  /// Questions to ask on the call, written for this applicant: Probe[] (src/lib/probes.ts).
  probes         Json      @default("[]")
  /// An unlisted read-only link to this applicant (/s/<slug>). Null when not shared.
  shareSlug      String?   @unique
  sharedAt       DateTime?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate   Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  listing     Listing?     @relation(fields: [listingId], references: [id], onDelete: SetNull)
  submissions Submission[]
  notes       Note[]
  messages    Message[]
  interviews  Interview[]
  offers      Offer[]
  references  Reference[]

  @@unique([jobId, candidateId])
  @@index([userId, jobId, stage])
}

/// One filled-in form.
model Submission {
  id            String   @id @default(cuid())
  userId        String
  formId        String
  applicationId String
  candidateId   String
  /// Time from the form opening to submit.
  durationMs    Int      @default(0)
  /// Did the page's recorder report at all? False means no telemetry (script blocked, API import).
  recorded      Boolean  @default(false)
  /// Knockout questions answered outside their rule: KnockoutResult[] from src/lib/forms.ts.
  failed        Json     @default("[]")
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  form        Form        @relation(fields: [formId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidate   Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  answers     Answer[]

  @@index([userId, applicationId])
}

/// How an answer's text arrived. See src/lib/provenance.ts.
enum Origin {
  TYPED
  PASTED
  MIXED
  /// Text appeared with no keystrokes or paste: browser autofill, an extension, a script.
  INJECTED
  /// No telemetry (choice questions, or the recorder did not run).
  UNKNOWN
}

model Answer {
  id           String @id @default(cuid())
  userId       String
  submissionId String
  questionId   String
  /// The question as it was asked, so editing a form never rewrites an old answer.
  label        String
  value        String
  origin       Origin @default(UNKNOWN)
  /// Share of the final text that was pasted or injected, 0..1.
  pastedShare  Float  @default(0)
  /// Raw recorder counts for this field. Kept so the verdict can be recomputed.
  telemetry    Json   @default("{}")
  /// Writing-style signals that often mark generated text. 0..1, a hint and never a verdict.
  styleScore   Float  @default(0)
  styleSignals Json   @default("[]")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  uploads    Upload[]

  @@index([userId, submissionId])
}

/// A file an applicant attached to a "file" question: a setup photo, a speed
/// test, a portfolio PDF.
///
/// THE BYTES ARE IN THIS ROW, the call Hired's Attachment makes, because an
/// object store would mean settings beyond DATABASE_URL. A bytea is only read
/// when selected, so every read in src/lib/data/uploads.ts names its columns
/// and only the one that serves the file names `data`.
///
/// It always belongs to one answer and cascades with it.
model Upload {
  id        String   @id @default(cuid())
  userId    String
  answerId  String
  /// As it arrived, cleaned of path separators. What a download is called.
  filename  String
  /// Sniffed from the file's first bytes, never trusted from the browser.
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  answer Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@index([userId, answerId])
}

model Note {
  id            String   @id @default(cuid())
  userId        String
  applicationId String
  body          String
  /// "app" or "mcp"
  writtenBy     String   @default("app")
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId, applicationId])
}

enum MessageKind {
  RECEIPT
  SCREENING_INVITE
  INTERVIEW_INVITE
  REJECTION
  OFFER
  OTHER
}

enum MessageStatus {
  DRAFT
  SENT
}

/// A message to an applicant. A draft goes out one of two ways: from the
/// person's own connected mailbox (sentVia "mailbox", only after they said
/// send), or from their own email by hand (the app's "Open in email", or their
/// assistant's mail connector) and then marked SENT (sentVia ""). Either way
/// the log says what each applicant was told and when.
model Message {
  id            String        @id @default(cuid())
  userId        String
  applicationId String
  kind          MessageKind
  status        MessageStatus @default(DRAFT)
  subject       String        @default("")
  body          String
  /// "app" or "mcp"
  writtenBy     String        @default("mcp")
  /// "mailbox" when Recruited sent it over the person's SMTP; "" when marked sent by hand.
  sentVia       String        @default("")
  /// Why the last send from the mailbox failed, if it did. Cleared on success.
  sendError     String        @default("")
  sentAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId, applicationId])
}

enum InterviewStatus {
  SCHEDULED
  DONE
  CANCELLED
  NO_SHOW
}

/// One conversation with an applicant. Rounds count up per application.
model Interview {
  id            String          @id @default(cuid())
  userId        String
  applicationId String
  round         Int
  /// What kind of conversation, in the person's words: "screening call", "work sample review", "final with the founder".
  title         String
  /// video | phone | in_person
  format        String          @default("video")
  scheduledAt   DateTime?
  durationMin   Int?
  /// Who they meet, as written: "Ana (ops lead), William".
  interviewers  String          @default("")
  /// A meeting link or an address.
  location      String          @default("")
  /// Times offered to the applicant to pick from. Empty once they've picked or when a time was set directly.
  slots         DateTime[]      @default([])
  /// The applicant's booking link (/book/<token>) while slots are on offer.
  bookToken     String?         @unique
  status        InterviewStatus @default(SCHEDULED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scorecards  Scorecard[]

  @@index([userId, scheduledAt])
  @@index([userId, applicationId])
}

enum Recommendation {
  STRONG_YES
  YES
  NO
  STRONG_NO
}

/// One interviewer's verdict on one interview. Several interviewers, several scorecards.
model Scorecard {
  id             String         @id @default(cuid())
  userId         String
  interviewId    String
  interviewer    String
  recommendation Recommendation
  /// ScorecardRating[] from src/lib/scorecards.ts: criterion, score 1-4, note.
  ratings        Json           @default("[]")
  summary        String         @default("")
  /// "app" or "mcp"
  writtenBy      String         @default("app")
  createdAt      DateTime       @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([userId, interviewId])
}

enum OfferStatus {
  DRAFT
  EXTENDED
  ACCEPTED
  DECLINED
  WITHDRAWN
}

/// One version of an offer. Changing the terms writes a new version, so the
/// history of what was offered stays; a status change updates the version in place.
model Offer {
  id            String      @id @default(cuid())
  userId        String
  applicationId String
  version       Int
  title         String      @default("")
  payAmount     Int?
  payCurrency   String      @default("USD")
  /// hour | month | year
  payPeriod     String      @default("month")
  startDate     DateTime?
  /// "40 hours a week, 9am-6pm Manila time", as the person said it.
  hours         String      @default("")
  /// Anything else agreed, markdown: probation, equipment, leave.
  terms         String      @default("")
  respondBy     DateTime?
  status        OfferStatus @default(DRAFT)
  statusAt      DateTime?
  createdAt     DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, version])
  @@index([userId, applicationId])
}

/// Someone who can speak to an applicant's work. They answer three questions
/// through a personal link (/ref/<token>); nothing is emailed by this server.
model Reference {
  id            String    @id @default(cuid())
  userId        String
  applicationId String
  name          String
  email         String    @default("")
  /// How they know the applicant, as the applicant or hirer put it: "her manager at Lumen, 2022–2024".
  relation      String    @default("")
  token         String    @unique
  /// { questionId, label, value }[] once they answer.
  answers       Json      @default("[]")
  submittedAt   DateTime?
  createdAt     DateTime  @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId, applicationId])
}

/// Counts of public form posts per hashed address per hour, so one address
/// can't flood an apply page. Instance-level, not content: it holds no IP,
/// only a SHA-256 of it with the route, and rows older than a day are
/// cleared on the next post.
model RateHit {
  key    String
  window DateTime
  count  Int      @default(1)

  @@id([key, window])
  @@index([window])
}

/// Instance settings, keyed by name, configured from the app and by tool so
/// DATABASE_URL stays the only variable. Owner-only to change.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Server errors the app caught: where, what, when. Instance-level, read by
/// the owner through instance_health. Messages are cut to 500 characters and
/// the newest 1000 are kept.
model ErrorEvent {
  id        String   @id @default(cuid())
  where     String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// The person's own mailbox, over SMTP. Mail to applicants goes from this
/// address and nowhere else; the server never sends as itself. The password is
/// never returned by any read. One per workspace.
model Mailbox {
  id             String    @id @default(cuid())
  userId         String    @unique
  host           String
  port           Int
  /// "tls" (implicit, usually 465), "starttls" (usually 587) or "none" (a relay on a private network only)
  security       String    @default("starttls")
  username       String
  password       String
  fromEmail      String
  fromName       String    @default("")
  /// Send a receipt to everyone who applies through an apply link.
  receiptOn      Boolean   @default(true)
  /// Empty means the built-in wording.
  receiptSubject String    @default("")
  receiptBody    String    @default("")
  /// This instance's address as the person saw it when they last saved these
  /// settings, for links inside mail. Never taken from an applicant's request,
  /// whose Host header they control.
  siteUrl        String    @default("")
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
